<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Fetching the pages you share to it; nothing else goes out -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Who may read the read you're partway through: the family's apps (Momento in Fold Widgets) -->
    <permission
        android:name="com.cerniera.dorso.permission.READING"
        android:label="See the read you're partway through in Dorso"
        android:protectionLevel="normal" />

    <queries>
        <!-- Fold Widgets' look (finish, corners, the glass's images), as Nodo reads it. As a package,
             not a provider: the Kit may list providers, and two entries collide when manifests merge -->
        <package android:name="com.fergusonconsultancy.foldwidgets" />
    </queries>

    <application
        android:name=".DorsoApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.App"
        android:resizeableActivity="true">

        <!-- The shelf of saved reads. Folding and turning are handled in place. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|uiMode|density|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Share a link from Medium, The Athletic, Reddit or the browser -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- The spread. Folding and turning re-set the pages in place, keeping the sentence. -->
        <activity
            android:name=".ReaderActivity"
            android:exported="false"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|uiMode|density|keyboardHidden" />
        <!-- Signing in to a site you subscribe to, inside Dorso -->
        <activity
            android:name=".SignInActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|uiMode|density|keyboardHidden" />
        <!-- On the nightstand: the book you're reading, on the home screen -->
        <receiver
            android:name=".Nightstand"
            android:label="@string/nightstand_name"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/nightstand_info" />
        </receiver>
        <!-- The read you're partway through, for Momento's notes (22 Nov 2026) -->
        <provider
            android:name=".ReadingProvider"
            android:authorities="com.cerniera.dorso.reading"
            android:exported="true"
            android:readPermission="com.cerniera.dorso.permission.READING" />
        <!-- Fold Widgets says its look or the wallpaper changed -->
        <receiver android:name=".NightstandLook" android:exported="true">
            <intent-filter><action android:name="com.cerniera.LOOK_CHANGED" /></intent-filter>
        </receiver>
    </application>
</manifest>
